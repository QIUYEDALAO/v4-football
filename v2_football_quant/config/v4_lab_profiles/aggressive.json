{
  "profile_id": "aggressive",
  "profile_name": "V4 Lab Aggressive",
  "lab_only": true,
  "production_safe": false,
  "grade_schema": ["LAB_A", "LAB_B", "LAB_SKIP"],
  "allow_lab_observe_grade": true,
  "recent_form_sample_size": 10,
  "h2h_policy": "LEAGUE_PYRAMID_POST2020_ONLY",
  "full_scan": true,
  "include_outside57": true,
  "thresholds": {
    "lab_a_min_score": 55,
    "lab_b_min_score": 40
  },
  "weights": {
    "ht_score_weight": 1.2,
    "recent_form_weight": 1.0,
    "h2h_weight": 0.8
  },
  "filters": {
    "min_h2h_samples": 2,
    "min_recent_matches": 3
  },
  "notes": "Lab only. Lower thresholds to cast wider net."
}
